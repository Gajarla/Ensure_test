<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https:;
  style-src 'self' 'unsafe-inline' https:; img-src 'self' data: https:; font-src 'self' data: https:; connect-src 'self'
  https:; media-src 'self' blob:; worker-src 'self' blob:; child-src 'self' blob:; frame-src 'self' https:; base-uri
  'self'; form-action 'self'; manifest-src 'self';"
</IfModule>
